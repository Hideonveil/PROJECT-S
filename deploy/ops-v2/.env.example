# Copy to .env.local on the founder Mac. Never commit .env.local or .secrets/.
# All services bind to localhost and access Production only through SSH tunnels.
APPSMITH_ENCRYPTION_PASSWORD=
APPSMITH_ENCRYPTION_SALT=
OPS_V2_API_KEY=
OPS_METRICS_TOKEN=
APPSMITH_DISABLE_TELEMETRY=true

METABASE_APP_DB_NAME=metabase
METABASE_APP_DB_USER=metabase
METABASE_APP_DB_PASSWORD=
METABASE_JAVA_OPTS=-Xmx2g

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
