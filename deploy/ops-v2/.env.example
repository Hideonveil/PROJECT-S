# Copy to .env.production on the production host; never commit that file.
# Generate unique values with a password manager or cryptographic generator.
APPSMITH_ENCRYPTION_PASSWORD=
APPSMITH_ENCRYPTION_SALT=
OPS_V2_API_KEY=

# Appsmith is invitation-only and only reachable over the server's loopback port.
APPSMITH_DISABLE_TELEMETRY=true
