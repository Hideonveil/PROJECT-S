    },
    {
      "name": "previewCasualAttach",
      "method": "POST",
      "path": "/api/internal/ops-v2/casual/preview-attach"
    },
    {
      "name": "attachCasual",
      "method": "POST",
      "path": "/api/internal/ops-v2/casual/attach",
      "action": "ADMIN_ATTACH_CASUAL_USER",
      "requires": "preview result and operator reason"
    },
    {
      "name": "lockCasualRoom",
      "method": "POST",
      "path": "/api/internal/ops-v2/casual/lock",
      "action": "ADMIN_LOCK_CASUAL_ROOM",
      "requires": "preview result and operator reason"
