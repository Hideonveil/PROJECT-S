# Public hostname, without https:// or www.
DOMAIN=play.example.com

# Temporary direct-IP fallback, without http://
IP_ADDRESS=203.0.113.10

# Long random token used only by /api/ops/metrics.
OPS_TOKEN=

# Optional webhook for server down/recovery alerts.
ALERT_WEBHOOK_URL=

# Host only, for example chqxaqibegpdjtedrxwx.supabase.co
SUPABASE_UPSTREAM_HOST=project-ref.supabase.co

# Browser traffic goes through Caddy on the same public domain.
SUPABASE_PUBLIC_URL=https://play.example.com

# Server-side traffic goes directly from Hong Kong to Supabase.
SUPABASE_INTERNAL_URL=https://project-ref.supabase.co

# Kept for compatibility with the existing Vercel configuration.
NEXT_PUBLIC_SUPABASE_URL=https://project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

RESEND_API_KEY=
FEEDBACK_TO_EMAIL=
RESEND_FROM_EMAIL=
OPS_TOKEN=
OPS_PASSWORD=
ALERT_WEBHOOK_URL=
APP_VERSION=

# Concentrated normal-user login capacity per source IP. Keep the per-account
# login protection in the application and Supabase Auth protections enabled.
AUTH_LOGIN_IP_LIMIT=300
