# Supabase (public-safe values)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional deployment overrides. In the Hong Kong deployment, browsers use the
# same public domain while server-side requests keep a direct Supabase route.
SUPABASE_PUBLIC_URL=
SUPABASE_INTERNAL_URL=

# Supabase service role - server only, never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=

